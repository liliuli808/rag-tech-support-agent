# =====================================================================
# Atlas - Technical Support AI Agent (RAG) - configuration
# =====================================================================
# Copy this file to `.env` and fill in your credentials:
#
#     cp .env.example .env
#
# `.env` is read by the notebook (section 3), by tools/ask.py and by
# tools/webui.py. Never commit it: it holds a live credential.
#
# Values already present in the real environment take precedence over this
# file, so a CI secret or a shell export is never clobbered by a stale
# local copy.
# =====================================================================

# --- embedding backend ------------------------------------------------
# Which half of the pipeline runs where. Two settings:
#
#   api    embed through OPENAI_BASE_URL using OPENAI_EMBED_MODEL.
#   local  embed with a local sentence-transformers model - no key, no
#          per-token cost, and no network round trip at query time.
#
# Generation is always remote, so OPENAI_API_KEY stays REQUIRED either way.
# With "local" the key is used for chat completions only.
#
# The embedded vectors are not interchangeable between backends: they live
# in different spaces and usually have different dimensions. Switching this
# after an index has been built means the old index must be rebuilt.
EMBED_BACKEND=api

# --- credential (REQUIRED) -------------------------------------------
# Any OpenAI-compatible key. The agent has no offline mode: without this
# the notebook stops in section 3 with a diagnostic instead of degrading.
OPENAI_API_KEY=sk-your-key-here

# --- endpoint (optional) ---------------------------------------------
# Point this at any OpenAI-compatible gateway: the official API, a
# corporate proxy, a self-hosted vLLM / Ollama / LiteLLM gateway, or a
# third-party relay.
#
# Leave it unset (or comment it out) to use https://api.openai.com/v1.
#
# Caveat: many third-party relays proxy chat completions ONLY and answer
# 404 on /embeddings. With EMBED_BACKEND=api the preflight in section 3.5
# detects exactly that and says so, rather than failing later with a
# cryptic error. With EMBED_BACKEND=local the embeddings route is not
# needed at all, so a chat-only relay becomes perfectly usable.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- models (optional) -----------------------------------------------
# Used when EMBED_BACKEND=api, and must be an EMBEDDINGS model served by
# OPENAI_BASE_URL. It must stay the SAME between indexing and querying:
# changing it after the index is built silently breaks retrieval, because
# query vectors and chunk vectors would no longer live in the same space.
# If you change it, delete artifacts/vector_store and re-run.
OPENAI_EMBED_MODEL=text-embedding-3-small

# OPENAI_CHAT_MODEL must be a CHAT model served by OPENAI_BASE_URL.
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- local embedding model (used when EMBED_BACKEND=local) ------------
# A sentence-transformers model id. Downloaded once from Hugging Face into
# ~/.cache/huggingface on first use, then fully offline.
#
#   BAAI/bge-small-en-v1.5    384-d   ~130 MB   English
#   BAAI/bge-small-zh-v1.5    512-d    ~95 MB   Chinese
#   BAAI/bge-m3              1024-d   ~2.3 GB   multilingual, cross-lingual
#   BAAI/bge-large-zh-v1.5   1024-d   ~1.3 GB   Chinese, higher quality
#
# The default is the multilingual model, so one index serves English, Chinese
# and Russian questions. On a corpus this small the extra weight buys
# cross-lingual retrieval rather than raw accuracy - switch to bge-small-en-v1.5
# if you only ever ask in English and want a much faster load.
LOCAL_EMBED_MODEL=BAAI/bge-m3

# Section 12 fine-tunes its own backbone, decoupled from the setting above.
# Full fine-tuning of bge-m3 - 568M parameters plus an Adam state several times
# that size - does not fit comfortably in CPU RAM, so the training demonstration
# keeps the 33M English model. Point this at LOCAL_EMBED_MODEL to fine-tune the
# multilingual backbone instead.
# FT_BASE_MODEL=BAAI/bge-small-en-v1.5

# --- generation behaviour (optional) ---------------------------------
# 0 keeps a support agent reproducible and the evaluation repeatable.
# Raise it only if you actually want variation between runs.
OPENAI_TEMPERATURE=0
